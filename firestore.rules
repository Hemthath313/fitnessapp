rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection and subcollections
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Workouts collection
    match /workouts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // All workouts collection
    match /allWorkouts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Finished workouts collection
    match /finishedWorkouts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Meals collection
    match /meals/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Statistics collection (NEW)
    match /statistics/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Weight progress spots
    match /flSpots/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      match /flSpotsData/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Body measurement spots
    match /measurementSpots/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      match /{measurementType}/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Config collection (public read, write denied)
    match /config/{document=**} {
      allow read: if true;
    }

    // Feedback collection (create-only for authenticated users)
    match /feedback/{documentId} {
      allow create: if isAuthenticated();
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

